---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
const all = await getCollection('articles', ({data}) => data.status === 'publish');
const featured = all.slice().sort((a,b)=>b.data.date.localeCompare(a.data.date)).slice(0,3);
const card = (entry) => ({title:entry.data.title, href: (()=>{try{return new URL(entry.data.original_url).pathname}catch{return '/'+entry.data.slug+'/'}})(), image:entry.data.featured_image, date:entry.data.date.slice(0,10)});
---
<Base title="Новые Горизонты — Космос. Наука. Технологии."><section class="wrap" style="padding:90px 0 76px"><p class="accent" style="letter-spacing:.22em;text-transform:uppercase;font-size:12px">Научно-популярный журнал</p><h1 class="serif" style="font-size:clamp(48px,8vw,88px);line-height:1.04;max-width:850px;margin:18px 0">Космос. Наука.<br/><span class="accent">Технологии.</span></h1><p class="muted" style="font-size:20px;max-width:650px">Открываем удивительное в окружающем мире — от далёких галактик до прорывов медицины и технологий будущего.</p><a class="btn" href="#featured" style="margin-top:22px">Читать интересные статьи</a></section><section id="featured" class="wrap" style="padding:24px 0 50px"><div style="display:flex;justify-content:space-between;align-items:end;gap:20px"><div><p class="accent">Рекомендуем</p><h2 class="serif" style="font-size:38px;margin:0">Интересные статьи</h2></div><span class="muted">Из архива редакции</span></div><div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(250px,1fr));gap:20px;margin-top:28px">{featured.map(e=>{const c=card(e);return <a class="card" href={c.href}><div style="aspect-ratio:16/10;background:#101a29">{c.image&&<img src={c.image} alt="" style="width:100%;height:100%;object-fit:cover"/>}</div><div style="padding:20px"><p class="muted" style="font-size:12px">{c.date}</p><h3 class="serif" style="font-size:24px;line-height:1.25">{c.title}</h3><span class="accent">Читать →</span></div></a>})}</div></section><section class="wrap" style="padding:28px 0 70px;display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:16px">{[['Космос','Исследуем Вселенную, планеты и космические миссии','/category/kosmos/'],['Медицина','Открытия, здоровье и биотехнологии','/category/medicina/'],['Технологии','Инженерия, искусственный интеллект и инновации','/category/novye-tekhnologii/']].map(x=><a class="card" href={x[2]} style="padding:26px"><p class="accent">Раздел</p><h2 class="serif" style="font-size:30px">{x[0]}</h2><p class="muted">{x[1]}</p><span class="accent">Перейти →</span></a>)}</section></Base>
